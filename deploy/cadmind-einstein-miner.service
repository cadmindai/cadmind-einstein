# The reference einstein miner as a systemd user unit (systemctl --user). The agent CLI must be on
# PATH and already configured with your own model credentials; follow your provider's terms.
# --agent-key-file holds your own agent key (mode 0600): create it on the developer platform, on the
# account your hotkey is linked to, naming the hotkey (docs/MINER.md, section 2).
# The self-review (on by default) runs the validators' judge on your own model key: put the key in
# the file named by --self-review-key-file (mode 0600, pip install '.[review]'); without the file
# the round is skipped and the miner works as before. --self-review off turns it off.
# The miner updates itself to new releases between jobs (never during one) and restarts in place
# (same PID); add --no-auto-update (or Environment=CADMIND_MINER_AUTO_UPDATE=0) to turn that off.
[Unit]
Description=CADmind einstein reference miner
After=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Claude Code on an Anthropic API key instead of a sign-in: one line ANTHROPIC_API_KEY=... in a 0600 file
# (docs/MINER.md, "Your model provider's terms are your responsibility").
#EnvironmentFile=%h/.config/cadmind-einstein/model.env
ExecStart=%h/cadmind-einstein/.venv/bin/cadmind-einstein-miner \
  --wallet.name MINER_WALLET --wallet.hotkey MINER_HOTKEY_NAME \
  --validator https://VALIDATOR_HOST --validator-hotkey VALIDATOR_SS58 \
  --platform https://platform.cadmind.ai \
  --state %h/.local/share/cadmind-einstein-miner \
  --agent-key-file %h/.config/cadmind-einstein/agent.key \
  --self-review-key-file %h/.config/cadmind-einstein/judge.key
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
